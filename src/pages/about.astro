---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import ProfileImage from '@/components/ProfileImage.astro'
import Layout from '@/layouts/Layout.astro'
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="About" />
  <Breadcrumbs items={[{ label: 'About', icon: 'lucide:info' }]} />

  <section>
    <div class="min-w-full">
    <div class="flex flex-col items-center gap-6 p-6 sm:flex-row sm:items-center">
      <ProfileImage
        size={128}
        eager
        class="border-border size-32 shrink-0 rounded-full border-2 object-cover shadow-md"
      />
      <div class="flex flex-col space-y-1.5 text-center sm:text-left">
        <h3 class="text-3xl leading-none font-medium">Yash Srivastava</h3>
        <p class="text-muted-foreground text-sm">Software Engineer</p>
      </div>
    </div>
    <div class="p-6 pt-0">
      <p class="text-muted-foreground text-sm">
        Passionate about software engineering and AI. This blog will also contain my philosophical musings and words on books I read.      </p>
    </div>
    </div>
  </section>
</Layout>
