---
import BlogCard from '@/components/BlogCard.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import ProfileImage from '@/components/ProfileImage.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import { buttonVariants } from '@/components/ui/button'
import { SITE, SOCIAL_LINKS, ICON_MAP, experience } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getRecentPosts, getRecentProjects } from '@/lib/data-utils'
import type { SocialLink } from '@/types'
import { Icon } from 'astro-icon/components'
import { cn } from '@/lib/utils'
import Skills from '@/components/React/Skills'
import ErrorBoundary from '@/components/React/ErrorBoundary'

const blog = await getRecentPosts(SITE.featuredPostCount)
const projects = await getRecentProjects(SITE.featuredProjectCount)
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Portfolio of Yash Srivastava" />
  <section class="rounded-lg border relative shadow-lg overflow-hidden">
    <div class="absolute inset-0 z-[1] bg-gradient-to-b from-background/95 via-background/70 to-background/95 dark:from-background/98 dark:via-background/85 dark:to-background/98"></div>

    <div class="relative z-[2] p-8 space-y-6">
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-green-500/10 border border-green-500/20 w-fit">
        <span class="relative flex size-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
          <span class="relative inline-flex size-2 rounded-full bg-green-500"></span>
        </span>
        <span class="text-xs font-medium text-green-700 dark:text-green-400 uppercase tracking-wide">Available for work</span>
      </div>

      <!-- Profile Picture, Heading & Description -->
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center">
        <ProfileImage
          size={112}
          eager
          class="size-24 sm:size-28 shrink-0 rounded-full border-2 border-border object-cover shadow-md"
        />
        <div class="space-y-4">
          <h1 class="text-4xl md:text-5xl font-bold leading-tight">
            Hi, I'm <span class="bg-gradient-to-r from-primary via-primary to-foreground bg-clip-text text-transparent">Yash Srivastava</span>
          </h1>
          <p class="text-base md:text-lg text-muted-foreground max-w-2xl leading-relaxed">
            Software engineer passionate about building meaningful technology and responsible AI.
            Seeking opportunities to create impactful solutions.
          </p>
        </div>
      </div>

      <!-- CTAs -->
      <div class="flex flex-wrap items-center gap-3">
        <Link
          href="https://drive.google.com/file/d/1X0ScXGWfvPF72YIcuDVYvC1v9HFCACmn/view?usp=sharing"
          class={buttonVariants({ variant: 'default', size: 'lg' })}
          external
        >
          <Icon name="lucide:file-text" class="size-4" />
          View Resume
        </Link>
        <Link href="/about" class={buttonVariants({ variant: 'outline', size: 'lg' })}>
          About me
        </Link>
      </div>

      <!-- Divider -->
      <div class="h-px bg-border/50"></div>

      <!-- Social Links -->
      <div class="flex flex-wrap items-center gap-3">
        <ul class="flex flex-wrap items-center gap-2" role="list">
          {SOCIAL_LINKS.map(({ href, label }: SocialLink) => (
            <li>
              <Link
                href={href}
                aria-label={label}
                title={label}
                class={buttonVariants({ variant: 'ghost', size: 'icon' }) + ' hover:bg-muted/50'}
                external={href.startsWith('http') || href.startsWith('mailto:')}
              >
                <Icon
                  name={
                    ICON_MAP[label as keyof typeof ICON_MAP] ||
                    'lucide:message-circle-question'
                  }
                  class="size-4"
                />
              </Link>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Education Section -->
  <section class="mt-12">
    <div class="mb-6">
      <h2 class="text-2xl font-semibold mb-2">Education</h2>
      <p class="text-sm text-muted-foreground">
        Academic background in computer science and software engineering
      </p>
    </div>

    <div class="space-y-6">
      <!-- UC Irvine -->
      <div class="rounded-lg border bg-card p-6 shadow-sm">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 mb-3">
          <div>
            <h3 class="font-semibold text-lg leading-tight">University of California, Irvine</h3>
            <p class="text-sm text-muted-foreground mt-1">
              Master of Software Engineering
            </p>
          </div>
          <div class="text-sm text-muted-foreground md:text-right">
            <p>Expected Dec 2026</p>
            <p>Irvine, USA</p>
          </div>
        </div>
      </div>

      <!-- SRM Institute -->
      <div class="rounded-lg border bg-card p-6 shadow-sm">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 mb-3">
          <div>
            <h3 class="font-semibold text-lg leading-tight">SRM Institute of Science and Technology</h3>
            <p class="text-sm text-muted-foreground mt-1">
              Bachelor of Technology - Computer Science and Engineering
            </p>
          </div>
          <div class="text-sm text-muted-foreground md:text-right">
            <p>May 2018</p>
            <p>Chennai, India</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Experience Timeline -->
  <section class="mt-12">
    <div class="mb-6">
      <h2 class="text-2xl font-semibold mb-2">Experience</h2>
      <p class="text-sm text-muted-foreground">
        6+ years in building web and AI applications
      </p>
    </div>

    {experience.length > 0 ? (
      <div class="space-y-6">
        {experience.map((exp, index) => (
          <div class="relative">
            {index < experience.length - 1 && (
              <div class="absolute left-[11px] top-8 bottom-0 w-px bg-border" aria-hidden="true"></div>
            )}

            <div class="flex gap-4">
              <div class={cn(
                "relative flex-shrink-0 w-6 h-6 rounded-full flex items-center justify-center ring-4 ring-background z-10",
                exp.current ? "bg-primary text-primary-foreground shadow-lg shadow-primary/20" : "bg-muted text-muted-foreground"
              )}>
                <Icon name={exp.icon} class="size-3.5" />
              </div>

              <div class="flex-1 pb-2 min-w-0">
                <div class="mb-1">
                  <h3 class="font-semibold text-lg leading-tight">{exp.role}</h3>
                  <p class="text-sm text-muted-foreground">
                    {exp.company} · {exp.period}
                  </p>
                </div>
                <p class="text-sm text-muted-foreground/90 leading-relaxed mt-2">
                  {exp.key}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <p class="text-sm text-muted-foreground italic">No experience data available.</p>
    )}
  </section>

  <!-- Skills & Technologies -->
  <section class="mt-12">
    <div class="mb-6">
      <h2 class="text-2xl font-semibold mb-2">Skills & Technologies</h2>
      <p class="text-sm text-muted-foreground">
        Core competencies across web, software engineering, and AI.
      </p>
    </div>
    <ErrorBoundary client:load transition:persist="skills-error-boundary">
      <Skills client:load transition:persist="skills-section" />
    </ErrorBoundary>
  </section>

  <!-- Projects -->
  <section class="mt-12">
    <div class="mb-6">
      <h2 class="text-2xl font-semibold mb-2">Projects</h2>
      <p class="text-sm text-muted-foreground">
        Selected work across web engineering and AI
      </p>
    </div>

    {projects.length > 0 ? (
      <>
        <ul class="flex flex-col gap-y-4 mb-6">
          {projects.map((project) => (
            <li>
              <ProjectCard project={project} />
            </li>
          ))}
        </ul>
        <div class="flex justify-center">
          <Link
            href="/projects"
            class={buttonVariants({ variant: 'ghost' }) + ' group'}
          >
            See all projects <span
              class="ml-1.5 transition-transform group-hover:translate-x-1"
              >&rarr;</span
            >
          </Link>
        </div>
      </>
    ) : (
      <p class="text-sm text-muted-foreground italic">No projects available yet.</p>
    )}
  </section>

  <!-- Recent Posts -->
  <section class="mt-12">
    <div class="mb-6">
      <h2 class="text-2xl font-semibold mb-2">Latest Posts</h2>
      <p class="text-sm text-muted-foreground">
        Recent articles and insights on technology and development
      </p>
    </div>

    {blog.length > 0 ? (
      <>
        <ul class="flex flex-col gap-y-4 mb-6">
          {blog.map((post) => (
            <li>
              <BlogCard entry={post} />
            </li>
          ))}
        </ul>
        <div class="flex justify-center">
          <Link
            href="/blog"
            class={buttonVariants({ variant: 'ghost' }) + ' group'}
          >
            See all posts <span
              class="ml-1.5 transition-transform group-hover:translate-x-1"
              >&rarr;</span
            >
          </Link>
        </div>
      </>
    ) : (
      <p class="text-sm text-muted-foreground italic">No blog posts available yet.</p>
    )}
  </section>
</Layout>
